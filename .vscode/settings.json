{
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop",
        "editor.formatOnSave": true,
        "editor.rulers": [120],
        "editor.minimap.enabled": false
    },
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-m",
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-l=%WORKSPACE_FOLDER%/latexindent.yaml"
    ],
    "latex-workshop.latex.jobname": "Szucs_Daniel_BSY9BQ_MSc_Thesis",
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/dist",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.latex.recipe.default": "Build thesis",
    "latex-workshop.latex.recipes": [
        {
            "name": "Build thesis",
            "tools": [
                "latexmk-thesis"
            ]
        },
        {
            "name": "Build slides",
            "tools": [
                "latexmk-slides"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-thesis",
            "command": "latexmk",
            "args": [
                "-r",
                "%WORKSPACE_FOLDER%/.latexmkrc",
                "-synctex=1",
                "-file-line-error",
                "-jobname=Szucs_Daniel_BSY9BQ_MSc_Thesis",
                "%WORKSPACE_FOLDER%/src/thesis.tex"
            ]
        },
        {
            "name": "latexmk-slides",
            "command": "latexmk",
            "args": [
                "-r",
                "%WORKSPACE_FOLDER%/.latexmkrc",
                "-synctex=1",
                "-file-line-error",
                "-jobname=Szucs_Daniel_BSY9BQ_MSc_Thesis_Slides",
                "%WORKSPACE_FOLDER%/src/slides.tex"
            ]
        }
    ],
    "latex-workshop.latex.search.rootFiles.include": [
        "**/thesis.tex",
        "**/slides.tex"
    ],
    "latex-workshop.linting.chktex.enabled": true,
    "latex-workshop.view.pdf.viewer": "browser"
}
